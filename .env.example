# Copy to .env. docker compose and the app both read it. NEVER commit the real file.

# ---- required secrets (generate: openssl rand -hex 24)
API_KEY=
POSTGRES_PASSWORD=
# READONLY_API_KEY=            # optional second key that may only GET

# ---- local development without Docker
DATABASE_URL=sqlite:///./vulncorrelator.db
# AUTH_DISABLED=true           # explicit opt-out of authentication; local development ONLY
# REDIS_URL=redis://localhost:6379/0   # enables background jobs, shared rate limits, cache

# ---- threat intelligence
INTEL_LIVE_SYNC=true           # false for air-gapped deployments
INTEL_DEMO_DATA=false          # true = bundled DEMONSTRATION catalog (labelled origin=demo; incomplete)
# NVD_API_KEY=                 # optional: raises NVD's rate limit (client stays inside the published limits)
# KEV_TTL_HOURS=48  EPSS_TTL_HOURS=48  NVD_TTL_HOURS=168  INTEL_SYNC_INTERVAL_HOURS=24

# ---- limits and behaviour
MAX_UPLOAD_MB=20
RATE_LIMIT_ENABLED=true
# RISK_MODEL_CONFIG_PATH=/etc/vulncorrelator/risk.json   # override scoring parameters (versioned by config hash)
